# Uni Route environment variables
#
# Copy this file to `.env.local` for local development.
# In GitHub Pages, configure these values as repository secrets before running the workflow.
#
# Recommended provider for a larger free tier:
# 1. Create an account at https://ipinfo.io/
# 2. Copy your token from https://ipinfo.io/account/token
# 3. Paste it here without quotes.
VITE_IPINFO_TOKEN=

# Optional secondary provider:
# 1. Create an account at https://ipgeolocation.io/
# 2. Copy your API key from https://app.ipgeolocation.io/
# 3. Paste it here without quotes.
VITE_IPGEOLOCATION_API_KEY=

# If both variables are empty, Uni Route falls back to ipapi.co without an API key.
